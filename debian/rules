#!/usr/bin/make -f
#export DH_VERBOSE = 1

CONFIG := -Denable_drm=enabled \
	  -Denable_egl=enabled \
	  -Denable_libav=enabled \
	  -Denable_opencv=enabled \
	  -Denable_qt=enabled \
	  -Denable_tflite=disabled \
	  -Denable_imx500=false \
	  -Denable_hailo=disabled

%:
	dh $@

execute_after_dh_install:
	rm -v -f $(addsuffix _*.json, $(addprefix debian/rpicam-apps-core/usr/share/rpi-camera-assets/,hailo imx500))
	rm -v -f debian/rpicam-apps-core/usr/share/rpi-camera-assets/*_tf.json
	rm -v -f debian/rpicam-apps-preview/usr/lib/*/rpicam-apps-preview/drm-preview.so

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIG)
